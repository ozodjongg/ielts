# Railway backend service
DATABASE_URL=${{Postgres.DATABASE_URL}}
AUTO_MIGRATE=false

# Clean vocabulary auto-import. The Docker entrypoint imports the selected
# dataset exactly once per VOCAB_DATASET_VERSION. If the clean Stage 1 file is
# absent, it falls back to the 180-word clean bootstrap corpus.
VOCAB_AUTO_IMPORT=true
VOCAB_DATASET_VERSION=stage1-clean-v1
VOCAB_WORDS_FILE=/app/data/vocabulary/generated/stage1_import_ready.csv
# Set only when the synonym file references words present in the imported corpus.
# VOCAB_SYNONYMS_FILE=/app/data/vocabulary/generated/stage1_synonyms_import_ready.csv

AUTH_JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_PLUS_CHARACTER_SECRET
AUTH_JWT_ISSUER=ielts-platform
AUTH_JWT_AUDIENCE=ielts-platform
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=30

INTERNAL_SIGNING_SECRET=CHANGE_ME_TO_A_DIFFERENT_RANDOM_64_PLUS_CHARACTER_SECRET
PLAYBACK_SIGNING_SECRET=CHANGE_ME_TO_A_DIFFERENT_RANDOM_64_PLUS_CHARACTER_SECRET
QUESTION_SHUFFLE_SECRET=CHANGE_ME_TO_A_DIFFERENT_RANDOM_64_PLUS_CHARACTER_SECRET
MFA_ENCRYPTION_KEY=CHANGE_ME_TO_A_DIFFERENT_RANDOM_64_PLUS_CHARACTER_SECRET

ADMIN_ORIGINS=https://YOUR_ADMIN_DOMAIN
CENTER_ORIGINS=https://YOUR_CENTER_DOMAIN
STUDENT_ORIGINS=https://YOUR_STUDENT_DOMAIN
TEACHER_ORIGINS=https://YOUR_TEACHER_DOMAIN

REQUIRE_ADMIN_AAL2=true
REQUIRE_CENTER_AAL2=true
REQUIRE_TEACHER_AAL2=true
GATEWAY_RATE_LIMIT_PER_MINUTE=600
GATEWAY_AUTH_RATE_LIMIT_PER_MINUTE=30
VOCAB_DAILY_NEW=10
VOCAB_DAILY_REVIEW=10
LISTENING_MAX_UPLOAD_MB=50
REVIEW_MAX_AUDIO_MB=20
DB_MAX_CONNS=4
DB_MIN_CONNS=0
