# IELTS Platform — self-hosted auth, one PostgreSQL database
# Copy to .env and replace every CHANGE_ME value.

POSTGRES_USER=ielts
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=app

# Authentication is owned by the Go backend. Generate a random secret >= 32 chars.
AUTH_JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_AUTH_SECRET
AUTH_JWT_ISSUER=ielts-platform
AUTH_JWT_AUDIENCE=ielts-platform
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=30

# Generate unrelated random secrets, at least 32 bytes each.
INTERNAL_SIGNING_SECRET=CHANGE_ME_64_CHAR_RANDOM_INTERNAL_SECRET
PLAYBACK_SIGNING_SECRET=CHANGE_ME_64_CHAR_RANDOM_PLAYBACK_SECRET
QUESTION_SHUFFLE_SECRET=CHANGE_ME_64_CHAR_RANDOM_QUESTION_SECRET
MFA_ENCRYPTION_KEY=CHANGE_ME_64_CHAR_RANDOM_MFA_ENCRYPTION_SECRET

# Public API + frontend origins
NEXT_PUBLIC_API_URL=http://localhost:8080
ADMIN_ORIGINS=http://localhost:3001
CENTER_ORIGINS=http://localhost:3002
STUDENT_ORIGINS=http://localhost:3003
TEACHER_ORIGINS=http://localhost:3004

AUTO_MIGRATE=true
REQUIRE_ADMIN_AAL2=true
REQUIRE_CENTER_AAL2=true
REQUIRE_TEACHER_AAL2=true
GATEWAY_RATE_LIMIT_PER_MINUTE=600
GATEWAY_AUTH_RATE_LIMIT_PER_MINUTE=30
VOCAB_DAILY_NEW=10
VOCAB_DAILY_REVIEW=10
LISTENING_MAX_UPLOAD_MB=50
REVIEW_MAX_AUDIO_MB=20
DB_MAX_CONNS=4
DB_MIN_CONNS=0
